generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Kullanıcı Tablosu
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  tasks     Task[]   // Bir kullanıcının birden fazla task'ı olabilir
  createdAt DateTime @default(now())
}

// Görev (Task) Tablosu
model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  // Soru işareti (?) bu alanın boş bırakılabileceğini gösterir
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, DONE gibi statüler olabilir
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}